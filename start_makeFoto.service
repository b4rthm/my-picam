[Unit]
Description=Starting PiCam capture daemon systemd service.
After=network.target

[Service]
User=root
Type=simple
Restart=always
RestartSec=10
StartLimitBurst=5
Environment=PYTHONPATH=/home/pi/.local/lib/python3.7/site-packages
WorkingDirectory=/home/pi/my-picam
ExecStartPre=/usr/bin/python3.7 -c "import sys; sys.path.insert(0, '/home/pi/my-picam'); import config, utils; utils.createFolders()"
ExecStart=/usr/bin/python3.7 /home/pi/my-picam/makeFoto.py

[Install]
WantedBy=multi-user.target
